# UniGrandBackup secrets — реальные значения из этого файла будут прочитаны
# по именам, указанным в config.yaml как *_env: <NAME>.
#
# Скопируй в .env и заполни.

# Telegram-бот для отправки бэкапов (один для всех сервисов или отдельные per service)
BACKUP_BOT_TOKEN=

# Пароли баз данных
BEDOLAGA_DB_PASSWORD=
N8N_DB_PASSWORD=

# Добавляй здесь любые другие *_env-переменные из config.yaml
